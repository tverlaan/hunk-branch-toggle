{
  "name": "hunk-branch-toggle",
  "version": "0.1.0",
  "private": true,
  "description": "Toggle Hunk between all uncommitted changes and the full branch diff.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tverlaan/hunk-branch-toggle.git"
  },
  "homepage": "https://github.com/tverlaan/hunk-branch-toggle#readme",
  "bugs": "https://github.com/tverlaan/hunk-branch-toggle/issues",
  "keywords": ["hunk", "hunk-extension", "git", "diff"],
  "type": "module",
  "hunk": {
    "apiVersion": 26,
    "extensions": ["./index.ts"]
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "test:pty": "python3 test/pty-smoke.py",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "hunkdiff": "0.24.1",
    "typescript": "^5.9.0"
  }
}
